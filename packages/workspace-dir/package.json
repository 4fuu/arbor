{
  "name": "@arbor/workspace-dir",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The plain-directory Workspace: one directory per window, with a continuation working in its predecessor's directory in place.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@arbor/errors": "workspace:*",
    "@arbor/interfaces": "workspace:*",
    "@arbor/prompt": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.2"
  }
}

#!/bin/sh
# Prepare a fresh machine for arbor.
#
# Node runs the TypeScript sources directly and every package's exports points
# at them, so the checks need no build: the setup installs the workspace
# dependencies and runs the checks once, so a broken environment fails here
# instead of in a later stage. `pnpm build` is run after them, because a machine
# that cannot produce what publishing needs is not a working environment either
# (docs/release.md).
#
# The toolchain has two paths. A machine with mise takes Node and pnpm from the
# repository's mise.toml, which installs them under ~/.local/share/mise; that is
# the path for Arch and other hosts without apt. A machine without mise is
# expected to carry Node 24 or newer and pnpm 12 already.

set -eu

if command -v mise >/dev/null 2>&1; then
  echo "toolchain: mise provides Node and pnpm from mise.toml"
  mise install
  # Every command below needs that toolchain on PATH. A shell that activated
  # mise (mise activate) already has it; any other shell gets it by running
  # this script through mise, once.
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "toolchain: re-running setup through mise so its tools are on PATH"
    exec mise x -- "$0" "$@"
  fi
fi

if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
  echo "setup: install Node 24 or newer and pnpm 12 first" >&2
  exit 1
fi

echo "node $(node --version)"
echo "pnpm $(pnpm --version)"

# arbor needs pnpm 12 and Node 24 or newer.
pnpm install --frozen-lockfile

pnpm check
pnpm build
